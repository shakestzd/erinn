{
  "$schema": "./manifest.schema.json",
  "_comment": "Single source of truth for the wipnote CLI companion plugin. Both the Claude Code plugin (plugin/) and the Codex CLI marketplace (port/packages/codex-marketplace/) are generated from this file by `wipnote plugin build-ports`. Assets (commands, agents, skills, templates, static, config) are sourced from plugin/ verbatim — same markdown format works for both Claude and Codex.",

  "name": "wipnote",
  "version": "0.67.1",
  "description": "Local-first observability and coordination platform for AI-assisted development. Go binary hooks for near-zero cold start.",
  "author": {
    "name": "Shakes Dlamini",
    "email": "shakestzd@gmail.com",
    "url": "https://github.com/shakestzd"
  },
  "homepage": "https://github.com/shakestzd/wipnote",
  "repository": "https://github.com/shakestzd/wipnote",
  "license": "MIT",
  "category": "Development Tools",
  "keywords": [
    "observability",
    "analytics",
    "workflow",
    "session-tracking",
    "agent-coordination",
    "wipnote",
    "git-based",
    "offline-first"
  ],

  "targets": {
    "claude": {
      "outDir": "plugin",
      "manifestPath": ".claude-plugin/plugin.json",
      "hooksPath": "hooks/hooks.json"
    },
    "codex": {
      "outDir": "port/packages/codex-marketplace",
      "manifestPath": ".codex-plugin/plugin.json",
      "hooksPath": "hooks.json",
      "mcpPath": ".mcp.json",
      "marketplaceName": "wipnote",
      "marketplaceDisplayName": "wipnote",
      "marketplaceCategory": "Development Tools",
      "pluginSubdir": ".agents/plugins/wipnote"
    },
    "antigravity": {
      "outDir": "port/packages/antigravity-extension",
      "manifestPath": "plugin.json",
      "hooksPath": "hooks.json",
      "mcpPath": "mcp_config.json",
      "contextFile": "plugin/contexts/ANTIGRAVITY.md",
      "commandNamespace": "wipnote"
    }
  },

  "assetSources": {
    "_comment": "Relative to repo root. Assets are copied verbatim into each target's outDir. Markdown-based formats (commands, agents, skills) are identical across Claude and Codex.",
    "commands": "plugin/commands",
    "agents": "plugin/agents",
    "skills": "plugin/skills",
    "templates": "plugin/templates",
    "static": "plugin/static",
    "config": "plugin/config"
  },

  "hooks": {
    "_comment": "Canonical event names follow Claude Code conventions. Each entry declares the CLI handler (a thin wrapper over `wipnote hook <name>`) and per-target availability. Events unsupported by a target are omitted from that target's hooks.json. Target-specific events are declared by listing only that target (e.g. `targets: [antigravity]` for AfterAgent). Every (name, target) pair is validated at build time against hookEventNameSpecs in port/pluginbuild/hook_event_names.go — no harness validates hook event names at dispatch, so an unlisted name is a silent permanent no-op and `wipnote plugin build-ports` refuses to emit it.",
    "events": [
      { "name": "SessionStart",       "handler": "session-start",       "targets": ["claude", "codex"] },
      { "name": "SessionStart",       "handler": "session-resume",      "targets": ["claude"], "matcher": "resume" },
      { "name": "SessionEnd",         "handler": "session-end",         "targets": ["claude", "codex"], "timeout": 90 },
      { "name": "UserPromptSubmit",   "handler": "user-prompt",         "targets": ["claude", "codex", "antigravity"] },
      { "name": "AfterAgent",         "handler": "after-agent",         "targets": ["antigravity"] },
      { "name": "UserPromptSubmit",   "handler": "timestamp",           "targets": ["claude"], "command": "date '+Current time: %Y-%m-%dT%H:%M:%S%z (%Z)'", "timeout": 2 },
      { "name": "PreToolUse",         "handler": "pretooluse",          "targets": ["claude", "codex", "antigravity"] },
      { "name": "PostToolUse",        "handler": "posttooluse",         "targets": ["claude", "codex", "antigravity"] },
      { "name": "PostToolUse",        "handler": "exit-plan-mode",      "targets": ["claude"], "matcher": "ExitPlanMode", "timeout": 30 },
      { "name": "SubagentStart",      "handler": "subagent-start",      "targets": ["claude", "codex"] },
      { "name": "SubagentStop",       "handler": "subagent-stop",       "targets": ["claude", "codex"] },
      { "name": "Stop",               "handler": "stop",                "targets": ["claude", "codex", "antigravity"], "timeout": 90 },
      { "name": "PostToolUseFailure", "handler": "posttooluse-failure", "targets": ["claude"] },
      { "name": "PreCompact",         "handler": "pre-compact",         "targets": ["claude"] },
      { "name": "TeammateIdle",       "handler": "teammate-idle",       "targets": ["claude"] },
      { "name": "TaskCompleted",      "handler": "task-completed",      "targets": ["claude"] },
      { "name": "InstructionsLoaded", "handler": "instructions-loaded", "targets": ["claude"] },
      { "name": "WorktreeCreate",     "handler": "worktree-create",     "targets": ["claude"] },
      { "name": "WorktreeRemove",     "handler": "worktree-remove",     "targets": ["claude"] },
      { "name": "PostCompact",        "handler": "post-compact",        "targets": ["claude"] },
      { "name": "TaskCreated",        "handler": "task-created",        "targets": ["claude"] },
      { "name": "PermissionRequest",  "handler": "permission-request",  "targets": ["claude"] },
      { "name": "ConfigChange",       "handler": "config-change",       "targets": ["claude"] }
    ]
  }
}
