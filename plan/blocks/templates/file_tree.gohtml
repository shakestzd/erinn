{{define "file_tree"}}<div class="block block-file-tree">
  <ul class="file-list">
    {{range .Rows}}<li class="file-entry">{{.Gutter}}{{if .Change}}<span class="file-change file-change-{{.Change}}">{{.Change}}</span> {{end}}<code class="file-path">{{.Path}}</code></li>
    {{end}}
  </ul>
</div>{{end}}
