{
  "permissions": {
    "allow": [
      "Write(//workspaces/htmlgraph/**)",
      "Edit(//workspaces/htmlgraph/**)",
      "NotebookEdit(//workspaces/htmlgraph/**)",
      "Bash(cd packages/go*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)"
    ],
    "deny": [
      "Write(//workspaces/htmlgraph/.htmlgraph/**)",
      "Edit(//workspaces/htmlgraph/.htmlgraph/**)",
      "NotebookEdit(//workspaces/htmlgraph/.htmlgraph/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/omp-claude-wrapper.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "plansDirectory": ".htmlgraph/plans/",
  "claudeMdExcludes": [
    "AGENTS.md"
  ]
}
